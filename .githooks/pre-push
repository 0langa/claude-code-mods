#!/bin/sh
# Runs before every push. Reads every commit that would reach the remote (the
# last line of defence: it also catches what an earlier commit let through) and
# blocks the push when one holds personal data.
#
# Git passes the remote's name as $1 and, on stdin, one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
remote="$1"
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch: nothing is published
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    sh "$root/.githooks/privacy-scan.sh" range "$remote_sha..$local_sha" || status=1
  else
    # A new branch, or a remote commit this clone does not have: everything not on the remote yet.
    sh "$root/.githooks/privacy-scan.sh" range "$local_sha" --not "--remotes=$remote" || status=1
  fi
done

exit $status
